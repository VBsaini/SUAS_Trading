# Free-tier hosted option: create a Gemini API key at https://aistudio.google.com/
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AI_MOD...lash

# Fully local option: install Ollama, pull a model, then use:
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_API_URL=http://localhost:11434/api/chat

NIFTY50_DATASET=kalyan1970/nifty50-stocks1999-2026-daily-ohlcv-and-fundamentals
NIFTY50_DATA_CSV_PATH=data/nifty50_ohlc.csv
